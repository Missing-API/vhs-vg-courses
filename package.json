{
  "name": "vhs-vg-courses",
  "version": "1.0.1",
  "description": "VHS VG Course Calendar API - Web scraping and calendar feed generation for Volkshochschule courses",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 9200",
    "build": "next build",
    "start": "next start",
    "stop": "lsof -ti:9200 | xargs kill -9",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "playwright install"
  },
  "keywords": [
    "next.js",
    "typescript",
    "web-scraping",
    "calendar",
    "ical",
    "vhs",
    "courses"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/next": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "@types/cheerio": "^1.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/swagger-ui-react": "^5.18.0",
    "cheerio": "^1.1.2",
    "ical-generator": "^11.1.4",
    "next": "^16.4.6",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "slugify": "^1.6.6",
    "swagger-ui-react": "^5.28.0",
    "typescript": "^6.0.3",
    "url-regex-safe": "^4.0.0",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@ts-rest/serverless": "^3.52.1",
    "@types/jsdom": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/ui": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.1",
    "playwright": "^1.55.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "26.x"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-import>eslint": "10",
        "eslint-plugin-jsx-a11y>eslint": "10",
        "eslint-plugin-react>eslint": "10"
      }
    }
  }
}
